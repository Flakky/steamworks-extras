# http://editorconfig.org
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.html]
indent_style = space
indent_size = 4
max_line_length = 9999

[*.js]
indent_style = space
indent_size = 4

[*.ts]
indent_style = space
indent_size = 4

[*.css]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 4
